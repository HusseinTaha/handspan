publish/
# NOT "*.app/" — gitignore matching is case-insensitive on Windows and macOS, so that pattern
# also matched the src/Handspan.App/ project directory and silently excluded the entire UI
# project from the repository. Bundles are produced under artifacts/, already ignored above.
TestResults/
*.trx
*.coverage
coverage*.json
coverage*.xml
BenchmarkDotNet.Artifacts/

