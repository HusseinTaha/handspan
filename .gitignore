.vs/
.vscode/
.idea/
*.swp
*~

## Handspan specific
# Bundled adb: fetched at build/first-run, never committed (Apache-2.0, ~10 MB)
tools/platform-tools/
# Bundled LGPL media binaries: fetched by script, never committed
tools/ffmpeg/
tools/vlc/
# Thumbnail + directory caches produced at runtime
cache/
*.db
*.db-shm
*.db-wal
# Diagnostic logs may contain file paths when verbose logging is enabled
logs/
*.log

