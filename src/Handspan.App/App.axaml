<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Handspan.App.App"
             RequestedThemeVariant="Default">
  <!-- "Default" follows the operating system's light/dark setting (spec section 89). -->
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>
</Application>
