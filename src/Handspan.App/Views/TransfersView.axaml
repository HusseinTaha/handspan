<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Handspan.App.ViewModels"
             mc:Ignorable="d"
             x:Class="Handspan.App.Views.TransfersView"
             x:DataType="vm:TransfersViewModel">

  <DockPanel>

    <Border DockPanel.Dock="Top" Padding="16,12"
            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="2">
          <TextBlock Text="Transfers" FontSize="20" FontWeight="Light" />
          <TextBlock Text="{Binding Summary}" FontSize="12" Opacity="0.7" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="Pause all" Command="{Binding PauseAllCommand}"
                  IsEnabled="{Binding HasActive}" />
          <Button Content="Resume all" Command="{Binding ResumeAllCommand}" />
          <Button Content="Clear finished" Command="{Binding ClearCompletedCommand}"
                  IsEnabled="{Binding HasCompleted}" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Padding="16">
      <StackPanel Spacing="18">

        <TextBlock Text="Nothing is transferring. Drag files onto the Explorer to copy them to the device, or use Download on a file."
                   TextWrapping="Wrap" Opacity="0.6" FontSize="13"
                   IsVisible="{Binding !HasActive}" />

        <!-- Active queue (spec section 11) -->
        <StackPanel Spacing="8" IsVisible="{Binding HasActive}">
          <TextBlock Text="ACTIVE" FontSize="11" FontWeight="SemiBold" Opacity="0.6" />
          <ItemsControl ItemsSource="{Binding Active}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TransferRowViewModel">
                <Border Margin="0,3" Padding="14" CornerRadius="6"
                        Background="{DynamicResource SystemControlBackgroundListLowBrush}">
                  <StackPanel Spacing="7">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding DirectionGlyph}" FontSize="16"
                                 Margin="0,0,8,0" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding FileName}" FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="12"
                                 Opacity="0.7" VerticalAlignment="Center" />
                    </Grid>

                    <ProgressBar Value="{Binding Percent}" Maximum="100" Height="6" />

                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding ProgressText}" FontSize="12" Opacity="0.7" />
                      <TextBlock Grid.Column="1" Text="{Binding SpeedText}" FontSize="12" Opacity="0.7" />
                    </Grid>

                    <TextBlock Text="{Binding Error}" FontSize="12" TextWrapping="Wrap" Opacity="0.8"
                               IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Button Content="Pause" Command="{Binding PauseCommand}" FontSize="12"
                              IsVisible="{Binding CanPause}" />
                      <Button Content="Resume" Command="{Binding ResumeCommand}" FontSize="12"
                              IsVisible="{Binding CanResume}" />
                      <Button Content="Cancel" Command="{Binding CancelCommand}" FontSize="12"
                              IsVisible="{Binding CanCancel}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- History (spec section 85) -->
        <StackPanel Spacing="8" IsVisible="{Binding HasCompleted}">
          <TextBlock Text="FINISHED" FontSize="11" FontWeight="SemiBold" Opacity="0.6" />
          <ItemsControl ItemsSource="{Binding Completed}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TransferRowViewModel">
                <Border Margin="0,2" Padding="12,10" CornerRadius="6"
                        Background="{DynamicResource SystemControlBackgroundListLowBrush}">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding DirectionGlyph}" Margin="0,0,8,0"
                               VerticalAlignment="Center" Opacity="0.7" />
                    <StackPanel Grid.Column="1" Spacing="2">
                      <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Error}" FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                                 IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="12" Opacity="0.7"
                               VerticalAlignment="Center" Margin="8,0" />
                    <Button Grid.Column="3" Content="Retry" FontSize="12"
                            Command="{Binding RetryCommand}" IsVisible="{Binding CanRetry}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>

  </DockPanel>

</UserControl>
