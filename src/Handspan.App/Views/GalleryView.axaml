<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Handspan.App.ViewModels"
             mc:Ignorable="d"
             x:Class="Handspan.App.Views.GalleryView"
             x:DataType="vm:GalleryViewModel">

  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CloseViewerCommand}" />
    <KeyBinding Gesture="Left" Command="{Binding StepCommand}" CommandParameter="previous" />
    <KeyBinding Gesture="Right" Command="{Binding StepCommand}" CommandParameter="next" />
    <KeyBinding Gesture="F5" Command="{Binding RefreshCommand}" />
    <!-- Windows-standard shortcuts (spec section 87) -->
    <KeyBinding Gesture="Ctrl+A" Command="{Binding SelectAllCommand}" />
    <KeyBinding Gesture="Ctrl+D" Command="{Binding ClearSelectionCommand}" />
    <KeyBinding Gesture="Ctrl+C" Command="{Binding DownloadSelectedCommand}" />
  </UserControl.KeyBindings>

  <Panel>
    <DockPanel>

      <Border DockPanel.Dock="Top" Padding="16,12"
              BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
              BorderThickness="0,0,0,1">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock Text="Gallery" FontSize="20" FontWeight="Light" />
              <TextBlock Text="{Binding Status}" FontSize="12" Opacity="0.7" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Button Content="All" Command="{Binding SetFilterCommand}" CommandParameter="All" />
              <Button Content="Photos" Command="{Binding SetFilterCommand}" CommandParameter="Image" />
              <Button Content="Videos" Command="{Binding SetFilterCommand}" CommandParameter="Video" />
              <Button Content="Rescan" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsScanning}" />
            </StackPanel>
          </Grid>

          <!-- Selection bar: appears only when something is selected (spec section 31, 34) -->
          <Border IsVisible="{Binding HasSelection}" CornerRadius="6" Padding="12,8"
                  Background="{DynamicResource SystemControlBackgroundListLowBrush}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="{Binding SelectionSummary}" VerticalAlignment="Center"
                         FontWeight="SemiBold" FontSize="13" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="Select all" Command="{Binding SelectAllCommand}" />
                <Button Content="Clear" Command="{Binding ClearSelectionCommand}" />
                <Button Content="Delete" Command="{Binding DeleteSelectedCommand}"
                        ToolTip.Tip="Permanently delete from the device" />
                <Button Content="Copy to this PC" Command="{Binding DownloadSelectedCommand}"
                        IsDefault="True" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- Shown while an album is open, so it is obvious the timeline is filtered -->
          <Border IsVisible="{Binding CurrentAlbum, Converter={x:Static ObjectConverters.IsNotNull}}"
                  CornerRadius="4" Padding="10,6"
                  Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12"
                         Text="{Binding CurrentAlbum.Name, StringFormat='Album: {0}'}" />
              <Button Grid.Column="1" Content="Show everything" FontSize="12"
                      Command="{Binding ShowAllCommand}" />
            </Grid>
          </Border>

          <TextBlock FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                     IsVisible="{Binding !HasSelection}"
                     Text="Tap the circle on a tile to select it, or Ctrl+click to toggle and Shift+click to select a range. Selected items can be copied or deleted in one go." />

          <!-- Albums as a horizontal strip, so the timeline keeps the vertical space (spec section 26) -->
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                        IsVisible="{Binding Albums.Count}" MaxHeight="58">
            <ItemsControl ItemsSource="{Binding Albums}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AlbumViewModel">
                  <!-- Clicking an album narrows the timeline to it (spec section 26) -->
                  <Button Padding="10,6" MinWidth="120" BorderThickness="0"
                          Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                          ToolTip.Tip="{Binding Path.Value}"
                          Command="{Binding $parent[UserControl].((vm:GalleryViewModel)DataContext).OpenAlbumCommand}"
                          CommandParameter="{Binding}">
                    <StackPanel Spacing="1" HorizontalAlignment="Left">
                      <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Summary}" FontSize="10" Opacity="0.65" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Border>

      <TextBlock DockPanel.Dock="Top" Margin="16" TextWrapping="Wrap" Opacity="0.6" FontSize="13"
                 IsVisible="{Binding !HasItems}"
                 Text="Nothing indexed yet. Rescan looks in DCIM, Pictures, Movies and Download." />

      <!--
        A ListBox over the date groups, because it virtualizes: only groups near the viewport are realized,
        and each tile fetches its thumbnail from its own Loaded event. Without virtualization a 20,000-photo
        phone would realize every tile at once and request every thumbnail (spec section 22, 94).
      -->
      <ListBox ItemsSource="{Binding Groups}" Background="Transparent" BorderThickness="0"
               SelectionMode="Single" Padding="10">
        <ListBox.Styles>
          <!-- These rows are layout containers, not selectable items. -->
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Background" Value="Transparent" />
          </Style>
          <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
          </Style>
          <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
          </Style>
        </ListBox.Styles>

        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:GalleryGroupViewModel">
            <StackPanel Spacing="6">
              <TextBlock Text="{Binding Header}" FontSize="13" FontWeight="SemiBold" Opacity="0.75"
                         Margin="4,0,0,0" />
              <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:GalleryItemViewModel">
                    <!-- Loaded drives thumbnail fetching, so only realized tiles hit the device.
                         Tapped opens the item; both are handled in code-behind because a command
                         bound through these nested repeaters resolves to the wrong data context. -->
                    <Border Width="132" Height="132" Margin="3" CornerRadius="4"
                            Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                            ToolTip.Tip="{Binding Name}"
                            Cursor="Hand"
                            Loaded="OnTileLoaded"
                            Tapped="OnTileTapped">
                      <Border.Styles>
                        <!-- Selected tiles get an accent border, so the selection is visible at a glance. -->
                        <Style Selector="Border">
                          <Setter Property="BorderThickness" Value="0" />
                        </Style>
                      </Border.Styles>
                      <Panel Background="Transparent">
                        <!-- Placeholder shows until a thumbnail arrives, and stays for formats that
                             need the ffmpeg decoder (phase 4b). -->
                        <TextBlock Text="{Binding Placeholder}" FontSize="28" Opacity="0.35"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}" />

                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />

                        <!-- Dim a selected tile so selection reads even on a bright photo. -->
                        <Panel Background="#663399FF" IsVisible="{Binding IsSelected}" />

                        <Border VerticalAlignment="Bottom" Background="#99000000" Padding="6,3">
                          <TextBlock Text="{Binding Name}" FontSize="10" Foreground="White"
                                     TextTrimming="CharacterEllipsis" />
                        </Border>

                        <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="4"
                                Background="#99000000" CornerRadius="3" Padding="4,1"
                                IsVisible="{Binding IsVideo}">
                          <TextBlock Text="▶ video" FontSize="9" Foreground="White" />
                        </Border>

                        <!-- Selection checkbox: lets a user multi-select with no modifier keys. -->
                        <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="4"
                                Width="22" Height="22" CornerRadius="11"
                                Background="#B0000000" Cursor="Hand"
                                ToolTip.Tip="Select"
                                Tapped="OnSelectTapped">
                          <TextBlock Text="✓" FontSize="12" Foreground="White"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Opacity="{Binding IsSelected, Converter={x:Static vm:SelectionOpacityConverter.Instance}}" />
                        </Border>
                      </Panel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

    </DockPanel>

    <!-- Bulk export confirmation before anything moves (spec section 34) -->
    <Border IsVisible="{Binding IsExportOpen}" Background="#80000000">
      <Border VerticalAlignment="Center" HorizontalAlignment="Center" Width="480" Padding="20"
              CornerRadius="8"
              Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
              BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
              BorderThickness="1">
        <StackPanel Spacing="12">
          <TextBlock Text="{Binding ExportPrompt}" TextWrapping="Wrap" FontWeight="SemiBold" />
          <StackPanel Spacing="4">
            <TextBlock Text="Destination" FontSize="11" Opacity="0.7" />
            <TextBox Text="{Binding ExportDestination}" />
          </StackPanel>
          <TextBlock FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                     Text="Files that already exist are kept alongside the new copies. Progress appears on the Transfers page, where the queue can be paused or resumed." />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Cancel" Command="{Binding CancelExportCommand}" />
            <Button Content="Copy" Command="{Binding ConfirmExportCommand}" IsDefault="True" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- Delete confirmation. Android has no recycle bin and this app does not fake one (spec section 51) -->
    <Border IsVisible="{Binding IsDeleteOpen}" Background="#80000000">
      <Border VerticalAlignment="Center" HorizontalAlignment="Center" Width="460" Padding="20"
              CornerRadius="8"
              Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
              BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
              BorderThickness="1">
        <StackPanel Spacing="12">
          <TextBlock Text="{Binding DeletePrompt}" TextWrapping="Wrap" FontWeight="SemiBold" />
          <TextBlock FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                     Text="This cannot be undone. Android has no recycle bin, so deleted files are not recoverable from here." />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Cancel" Command="{Binding CancelDeleteCommand}" IsCancel="True" />
            <Button Content="Delete" Command="{Binding ConfirmDeleteCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- Image viewer (spec section 23) -->
    <Border IsVisible="{Binding IsViewerOpen}" Background="#F0000000">
      <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="16,12">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Button Grid.Column="0" Content="←  Previous" Command="{Binding StepCommand}"
                    CommandParameter="previous" />
            <TextBlock Grid.Column="1" Text="{Binding SelectedItem.Name}" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
              <Button Content="Next  →" Command="{Binding StepCommand}" CommandParameter="next" />
              <Button Content="Close" Command="{Binding CloseViewerCommand}" />
            </StackPanel>
          </Grid>
        </Border>

        <Panel>
          <TextBlock Text="Loading…" Foreground="White" Opacity="0.7"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     IsVisible="{Binding SelectedItem.IsLoadingFullImage}" />

          <!-- Falls back to the thumbnail so opening an image is never a blank wait. -->
          <Image Source="{Binding SelectedItem.Thumbnail}" Stretch="Uniform" Margin="40"
                 IsVisible="{Binding SelectedItem.FullImage, Converter={x:Static ObjectConverters.IsNull}}" />
          <Image Source="{Binding SelectedItem.FullImage}" Stretch="Uniform" Margin="20" />
        </Panel>
      </DockPanel>
    </Border>

  </Panel>

</UserControl>
