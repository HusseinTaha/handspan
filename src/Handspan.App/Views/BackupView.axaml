<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Handspan.App.ViewModels"
             mc:Ignorable="d"
             x:Class="Handspan.App.Views.BackupView"
             x:DataType="vm:BackupViewModel">

  <ScrollViewer Padding="24">
    <StackPanel Spacing="18" MaxWidth="700" HorizontalAlignment="Left">

      <StackPanel Spacing="4">
        <TextBlock Text="Backup" FontSize="20" FontWeight="Light" />
        <TextBlock Text="Copy photos and videos to this computer, skipping anything already saved."
                   FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
      </StackPanel>

      <TextBlock Text="Connect a device to back it up." Opacity="0.6"
                 IsVisible="{Binding !HasSession}" />

      <StackPanel Spacing="18" IsVisible="{Binding HasSession}">

        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="1" CornerRadius="6" Padding="16">
          <StackPanel Spacing="12">

            <TextBlock Text="{Binding LastBackupText}" FontSize="12" Opacity="0.8" />

            <StackPanel Spacing="4">
              <TextBlock Text="Save to" FontSize="12" Opacity="0.7" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0" Text="{Binding Destination}" />
                <Button Grid.Column="1" Content="Open" Margin="8,0,0,0"
                        Command="{Binding OpenDestinationCommand}" />
              </Grid>
              <TextBlock FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                         Text="Files are grouped into year and month folders, for example 2026\2026-08." />
            </StackPanel>

            <CheckBox Content="Ignore the last backup and copy everything again"
                      IsChecked="{Binding BackUpEverything}" />

            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Check for new items" Command="{Binding CheckCommand}"
                      IsEnabled="{Binding !IsPlanning}" />
              <Button Content="Start backup" Command="{Binding RunCommand}"
                      IsEnabled="{Binding HasPlan}" IsDefault="True" />
            </StackPanel>

            <TextBlock Text="Scanning the device…" FontSize="12" Opacity="0.7"
                       IsVisible="{Binding IsPlanning}" />

          </StackPanel>
        </Border>

        <!-- What would be copied, before anything moves (spec section 34) -->
        <Border IsVisible="{Binding HasPlan}" CornerRadius="6" Padding="16"
                Background="{DynamicResource SystemControlBackgroundListLowBrush}">
          <StackPanel Spacing="6">
            <TextBlock Text="Ready to copy" FontSize="11" FontWeight="SemiBold" Opacity="0.6" />
            <TextBlock Text="{Binding PlanSummary}" TextWrapping="Wrap" FontSize="14" />
          </StackPanel>
        </Border>

        <StackPanel Spacing="6" IsVisible="{Binding ProgressPercent}">
          <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="8" />
          <TextBlock Text="{Binding ProgressPercent, StringFormat='{}{0:0}% complete'}"
                     FontSize="11" Opacity="0.7" />
        </StackPanel>

        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" Opacity="0.8" />

        <TextBlock FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                   Text="Backups go through the normal transfer queue, so they can be paused, resumed and retried on the Transfers page. Files that already exist are kept alongside rather than overwritten." />

      </StackPanel>

    </StackPanel>
  </ScrollViewer>

</UserControl>
