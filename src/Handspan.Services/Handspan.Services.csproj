<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The transfer manager and session are internal; their tests drive them directly because the
    interesting behaviour (resume, journalling, scheduling) is not observable through the interfaces
    alone.
  -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Handspan.Adb.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Handspan.Services.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Handspan.Core\Handspan.Core.csproj" />
    <ProjectReference Include="..\Handspan.Adb\Handspan.Adb.csproj" />
    <ProjectReference Include="..\Handspan.Data\Handspan.Data.csproj" />
    <ProjectReference Include="..\Handspan.Media\Handspan.Media.csproj" />
    <ProjectReference Include="..\Handspan.Search\Handspan.Search.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
