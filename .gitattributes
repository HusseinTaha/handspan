# Normalise line endings so the same file does not look modified on a different machine.
# Without this, Git warns on every add and a Windows checkout can produce spurious diffs.
* text=auto

# Source and docs: LF in the repository, native in the working copy.
*.cs        text diff=csharp
*.axaml     text
*.csproj    text
*.sln       text eol=crlf
*.props     text
*.targets   text
*.json      text
*.md        text
*.txt       text
*.xml       text
*.editorconfig text

# Shell scripts must keep LF even on Windows: /bin/sh will not run a script with CRLF endings,
# and finish-macos-build.sh is generated on Windows and run on a Mac.
*.sh        text eol=lf

# PowerShell is happy either way, but CRLF matches the platform it runs on.
*.ps1       text eol=crlf

# Binary, so Git never tries to translate them. Listing a format explicitly matters: anything
# not named here falls through to "* text=auto" above, which decides by sniffing for NUL bytes.
# That heuristic happens to get .icns right, but a binary format should not depend on a guess.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.icns      binary
*.webp      binary
*.zip       binary
*.apk       binary
*.so        binary
*.dylib     binary
*.dll       binary
